{
  "manifest_version": 3,
  "name": "NSolver: Coursera & NetAcad Solver / AutoPass",
  "short_name": "NSolver",
  "version": "2.13.1",
  "description": "NSolver — Coursera & Cisco NetAcad Solver / AutoPass by Naki: AI quiz solver (OctavAPI, Claude, ChatGPT, Gemini), hotkeys, skipping.",
  "author": "Naki",
  "homepage_url": "https://github.com/Naki-404/NSolver",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.coursera.org/*",
    "https://*.labs.coursera.org/*",
    "*://*.netacad.com/*",
    "*://*.netacad.net/*",
    "*://*.skillsforall.com/*",
    "https://octavapi.shop/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "icons": {
    "16": "images/16.png",
    "32": "images/32.png",
    "48": "images/48.png",
    "128": "images/128.png"
  },
  "action": {
    "default_title": "NSolver — made by Naki",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/16.png",
      "32": "images/32.png",
      "48": "images/48.png",
      "128": "images/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.coursera.org/learn/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.coursera.org/learn/*"
      ],
      "js": [
        "shared.js",
        "materials-core.js",
        "model-provider.js",
        "file-text.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.netacad.com/*",
        "*://*.netacad.net/*",
        "*://*.skillsforall.com/*"
      ],
      "js": [
        "shared.js",
        "materials-core.js",
        "model-provider.js",
        "netacad.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "*://*.netacad.com/*",
        "*://*.netacad.net/*",
        "*://*.skillsforall.com/*"
      ],
      "js": [
        "netacad-main.js"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.labs.coursera.org/*"
      ],
      "js": [
        "shared.js",
        "model-provider.js",
        "labs.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "https://*.labs.coursera.org/*"
      ],
      "js": [
        "labs-main.js"
      ],
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
